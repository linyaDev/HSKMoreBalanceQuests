<?xml version="1.0" encoding="utf-8"?>
<!-- Квесты с врагом берут в QuestNode_GetFaction только фракции с permanentEnemy (пираты, импиды,
     механоиды). После техгейта на низком уровне остаются одни импиды. Убираем условие у перечисленных
     квестов: allowEnemy=true без allowNeutral/allowAlly оставляет в пуле любые враждебные игроку фракции.
     Ненужный квест удаляется из списка ниже. -->
<Patch>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="ThreatReward_Raid_MiscReward"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="ThreatReward_Raid_Joiner"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="ThreatReward_RaidMultiFaction_Joiner"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="ThreatReward_MysteryThreat_Joiner"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="Hospitality_Util_Worker"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
  <Operation Class="PatchOperationRemove">
    <success>Always</success>
    <xpath>Defs/QuestScriptDef[defName="Util_RaidDelayRepeatable"]//li[@Class="QuestNode_GetFaction"]/mustBePermanentEnemy</xpath>
  </Operation>
</Patch>
