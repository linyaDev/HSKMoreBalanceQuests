<?xml version="1.0" encoding="utf-8"?>
<Patch>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/QuestScriptDef[defName="BuildMonumentWorker"]/root/nodes/li[@Class="QuestNode_GetMonumentSketch"]/pointsPerArea</xpath>
    <value>
      <pointsPerArea>40</pointsPerArea>
    </value>
  </Operation>
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/QuestScriptDef[defName="BuildMonumentWorker"]/root/nodes/li[@Class="QuestNode_GetLargestClearArea"]/max</xpath>
    <value>
      <max>11</max>
    </value>
  </Operation>
  <!-- Ваниль считает награду от стоимости ресурсов монумента; наш уменьшенный монумент
       упирается в потолок площадки ~на 4800 поинтах, и награда переставала расти.
       Считаем награду кривой от поинтов (множитель 1.4 за punishmentOnDestroy
       применяется после, как в вaниле). -->
  <Operation Class="PatchOperationReplace">
    <xpath>Defs/QuestScriptDef[defName="BuildMonumentWorker"]/root/nodes/li[@Class="QuestNode_Set"][name="rewardValue"]</xpath>
    <value>
      <li Class="QuestNode_EvaluateSimpleCurve">
        <value>$points</value>
        <storeAs>rewardValue</storeAs>
        <curve>
          <points>
            <li>(800, 700)</li>
            <li>(2000, 1200)</li>
            <li>(5000, 2000)</li>
            <li>(10000, 3000)</li>
            <li>(20000, 4500)</li>
          </points>
        </curve>
      </li>
    </value>
  </Operation>
</Patch>
