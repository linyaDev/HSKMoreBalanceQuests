<?xml version="1.0" encoding="utf-8"?>
<Defs>
	<HSKMoreBalanceQuests.Events.EventSettingsDef>
		<defName>HSKMoreBalanceQuests_EventSettings</defName>
		<label>HSKMoreBalanceQuests event settings</label>

		<!-- Событие (IncidentDef defName) -> минимальный техуровень игрока.
		     Уровень берётся из Ignorance Is Bliss, без него — техуровень фракции
		     игрока. Ниже порога событие не запускается ни рассказчиком, ни из
		     dev-меню (патчится общий вход IncidentWorker.CanFireNow). -->
		<incidentMinTechLevel>
			<li><key>LongNight</key><value>Industrial</value></li>
			<li><key>IceAge</key><value>Industrial</value></li>
			<!-- Терраформер механоидов: ультратех-постройка с погодным контроллером -->
			<li><key>MechanoidTerraformerIncident</key><value>Spacer</value></li>
		</incidentMinTechLevel>

		<!-- Вариант жуткого присоединившегося (Anomaly, CreepJoinerFormKindDef defName)
		     -> минимальный техуровень игрока. Вариант ниже порога не выбирается,
		     приходят остальные. Выбор в dev-меню не ограничивается. -->
		<creepJoinerFormMinTechLevel>
			<li><key>LoneGenius</key><value>Industrial</value></li>
			<!-- Толстокожий незнакомец — не раньше средневековья -->
			<li><key>LeatheryStranger</key><value>Medieval</value></li>
		</creepJoinerFormMinTechLevel>

		<!-- Гости Hospitality по техуровню (игрок — как выше, не ниже неолита):
		     на сколько уровней фракция гостей может быть выше / ниже игрока
		     (-1 = без ограничения). Приглашение через консоль связи не
		     ограничивается. -->
		<guestMaxTechAhead>0</guestMaxTechAhead>
		<guestMaxTechBehind>2</guestMaxTechBehind>
	</HSKMoreBalanceQuests.Events.EventSettingsDef>
</Defs>
